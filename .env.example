# ==============================================================================
# NEBWorld GROUP - Environment Configuration Template
# System: Mobile Money, Airtime, Data Bundles & Bill Payment Platform (Ghana)
# ==============================================================================

# Application Environment
FLASK_APP=run.py
FLASK_ENV=development
ENVIRONMENT_MODE=SANDBOX            # SANDBOX or PRODUCTION
DEBUG=True

# Security Keys
SECRET_KEY=change-this-to-a-secure-random-64-character-key-in-production
JWT_SECRET_KEY=change-this-to-a-secure-jwt-secret-in-production
WEBHOOK_SECRET=change-this-to-a-secure-webhook-secret

# Database Configuration (MySQL Recommended)
# Example: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/nebworld_db
DEV_DATABASE_URL=sqlite:///instance/nebworld_dev.db

# Platform Settings
BUSINESS_NAME=NEBWorld GROUP
BUSINESS_PHONE=+233240000000
BUSINESS_EMAIL=support@nebworld.com
COUNTRY=Ghana
DEFAULT_CURRENCY=GHS
TIMEZONE=Africa/Accra

# Rate Limiting
RATELIMIT_DEFAULT=200 per day;50 per hour;10 per minute
RATELIMIT_STORAGE_URI=memory://

# Security & Sessions
SESSION_COOKIE_SECURE=False          # Set to True when HTTPS is enabled
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
WTF_CSRF_ENABLED=True

# MTN Mobile Money API (SANDBOX vs PRODUCTION)
MOMO_API_ENV=sandbox
MOMO_API_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CALLBACK_URL=http://localhost:5000/api/v1/webhooks/mtn

# Telecel Cash API Settings
TELECEL_API_ENV=sandbox
TELECEL_API_KEY=
TELECEL_API_SECRET=
TELECEL_CALLBACK_URL=http://localhost:5000/api/v1/webhooks/telecel

# AirtelTigo (AT Money) Settings
AT_MONEY_API_ENV=sandbox
AT_MONEY_API_KEY=
AT_MONEY_CALLBACK_URL=http://localhost:5000/api/v1/webhooks/at-money

# SMS Notification Provider (e.g. Hubtel, Arkesel, Mnotify)
SMS_PROVIDER=arkesel
SMS_API_KEY=
SMS_SENDER_ID=NEBWorld
