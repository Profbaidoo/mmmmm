# Development Environment Settings
FLASK_APP=run.py
FLASK_ENV=development
ENVIRONMENT_MODE=SANDBOX
DEBUG=True

SECRET_KEY=nebworld-development-secret-key-ghana-2026-phase1
JWT_SECRET_KEY=nebworld-dev-jwt-secret-key-phase1
WEBHOOK_SECRET=nebworld-dev-webhook-secret-phase1
SECURITY_PASSWORD_PEPPER=nebworld-enterprise-secret-pepper-2026!@#

# Local Database (Fallback during Phase 1 testing; MySQL configured for Phase 2)
# When empty, falls back automatically to instance/nebworld_dev.db
DATABASE_URL=
DEV_DATABASE_URL=

